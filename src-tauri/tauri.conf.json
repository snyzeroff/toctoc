{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toc Toc",
  "version": "0.3.0",
  "identifier": "fr.toctoc.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Un ping entre un PC et un Mac",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxREM0MjYzRTM3NjE4NkQKUldSdEdIYmpZMExjZ1E2c3JXdEJCQlFtVjNhcGE1emJNY05JaForUVhKMWl4aXNjN3Fka25VY1QK",
      "endpoints": [
        "https://github.com/snyzeroff/toctoc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
